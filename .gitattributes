# README.txt keeps its exact bytes (UTF-8 BOM + CRLF): it is opened with Notepad on the user's PC.
*.txt -text

# Visual Studio writes solution files with CRLF; keep them that way on every OS.
*.sln text eol=crlf

# C# / WPF sources: normalized to LF in the repo, native line endings on checkout.
*.cs       text
*.xaml     text
*.csproj   text
*.manifest text
*.svg      text
*.yml      text
*.md       text

*.ico binary
*.png binary
