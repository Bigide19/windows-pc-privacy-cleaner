<Window x:Class="PcPrivacyCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PcPrivacyCleaner.Infrastructure"
        xmlns:m="clr-namespace:PcPrivacyCleaner.Models"
        Title="개인정보 정리 도구"
        Width="1280" Height="820" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13"
        Background="#F5F5F7">

    <Window.Resources>
        <!-- Light, Apple-like neutrals: gray window, white cards, one blue accent, red only for delete.
             The window gray (#F5F5F7) is set directly on <Window>: a StaticResource can not be used before it is defined. -->
        <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Text" Color="#1D1D1F" />
        <SolidColorBrush x:Key="Accent" Color="#007AFF" />
        <SolidColorBrush x:Key="Danger" Color="#FF3B30" />
        <SolidColorBrush x:Key="Line" Color="#E5E5EA" />
        <SolidColorBrush x:Key="Muted" Color="#6E6E73" />

        <!-- Assets/app.svg as a vector drawing for the title. Using app.ico here made WPF pick a small
             frame and scale it up, which looked blurry on high-DPI screens. Keep in sync with app.svg. -->
        <DrawingImage x:Key="AppIconVector">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- Transparent 256x256 frame so the drawing keeps the SVG's margins. -->
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H256 V256 H0 Z" />
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#3478C6" />
                                <GradientStop Offset="1" Color="#1A426A" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="8,8,240,240" RadiusX="56" RadiusY="56" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M128,42 L198,68 V122 C198,168 168,199 128,216 C88,199 58,168 58,122 V68 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FFFFFF" />
                                <GradientStop Offset="1" Color="#D9E6F4" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M94,128 L119,153 L164,104">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1F4E79" Thickness="19" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFD166" Geometry="M206,30 L212,48 L230,54 L212,60 L206,78 L200,60 L182,54 L200,48 Z" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <inf:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

        <!-- Toolbar buttons: white pills with a hairline border, padded so they are easy to hit. -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="#D2D2D7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Tag holds an optional icon glyph (Segoe MDL2 Assets, built into Windows 10/11),
                             drawn before the short label. Buttons without a Tag (e.g. 중지) show text only. -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F2F2F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White rounded card used for the list and the detail panel. -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- Main action button. Red for a real delete, blue for a dry run (set by the DataTrigger below). -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="24,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="Tag" Value="&#xE74D;" />  <!-- Delete (trash) -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="15" FontWeight="Normal"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDryRun}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}" />
                    <Setter Property="Tag" Value="&#xE768;" />  <!-- Play: nothing is deleted in a dry run -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,20,0,6" />
        </Style>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title -->
            <RowDefinition Height="Auto" />   <!-- account info -->
            <RowDefinition Height="Auto" />   <!-- toolbar -->
            <RowDefinition Height="*" />      <!-- list + detail -->
            <RowDefinition Height="Auto" />   <!-- delete bar -->
            <RowDefinition Height="Auto" />   <!-- log -->
        </Grid.RowDefinitions>

        <!-- ===== Title ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,20,24,0">
            <Image Source="{StaticResource AppIconVector}" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="개인정보 정리 도구" Foreground="{StaticResource Text}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="PC를 포맷하지 않고 개인정보만 골라서 지웁니다" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- ===== Account / scope info ===== -->
        <StackPanel Grid.Row="1" Margin="24,14,24,0">
            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                <Run Text="{Binding AccountText, Mode=OneWay}" />
                <LineBreak />
                <Run Text="{Binding ScopeText, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding OtherAccountText}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ShowOtherAccountWarning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- ===== Toolbar ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,14,24,12">
            <!-- Icon + short label; the longer explanation is in the tooltip. Glyphs: Segoe MDL2 Assets. -->
            <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Content="다시 검사" Command="{Binding ScanCommand}"
                    ToolTip="PC를 처음부터 다시 검사합니다." />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE7A7;" Content="되돌리기" Command="{Binding ResetCommand}"
                    ToolTip="체크 상태를 검사 직후의 처음 선택으로 되돌립니다." />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE73A;" Content="개인 파일 전체" Command="{Binding CheckAllFilesCommand}"
                    ToolTip="개인 파일 항목을 모두 체크합니다. 업무 파일이 섞여 있지 않은지 먼저 확인하세요." />
            <Button Style="{StaticResource ToolButton}" Tag="&#xEA18;" Content="관리자로 실행" Command="{Binding RelaunchAdminCommand}"
                    ToolTip="관리자 권한으로 다시 실행해서 이 PC의 다른 사용자까지 검사합니다."
                    Visibility="{Binding CanRelaunchAsAdmin, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- ===== List (left) + detail (right) ===== -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="480" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="4">
            <ListView x:Name="ItemList"
                      ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}"
                      SelectionMode="Single" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Text}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0,3" />
                        <Setter Property="ToolTip" Value="{Binding Name}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Forced}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <!-- A light gray band across the list plus a colored bar on the left, so the
                                 group headers stand apart from the rows and each category keeps its own color
                                 while scrolling. DataContext is the CollectionViewGroup; every item in a group
                                 has the same GroupInfo, so the first item supplies the color. -->
                            <DataTemplate>
                                <Border Background="#F2F2F7" CornerRadius="6" Margin="0,10,0,2" Padding="0,6,8,6">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="6,0,10,0"
                                                Background="{Binding Items[0].GroupInfo.Accent, Mode=OneWay}" />
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0}개)}" Foreground="{StaticResource Muted}" FontWeight="Normal" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.View>
                    <GridView>
                        <!-- Header text so the checkbox column does not look like a blank gap.
                             No "select all" box on purpose: it would also turn on the items that start
                             unchecked (corporate certificates, personal files, Wi-Fi) for good reason. -->
                        <GridViewColumn Header="선택" Width="44">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- No "user" column: it is the same for every row unless running as admin.
                             Other users' rows get the user name in front of the item name instead (DisplayName). -->
                        <GridViewColumn Header="항목" Width="300" DisplayMemberBinding="{Binding DisplayName}" />
                        <GridViewColumn Header="찾은 내용" Width="150" DisplayMemberBinding="{Binding SummaryText}" />
                        <GridViewColumn Header="지우는 범위" Width="100" DisplayMemberBinding="{Binding ScopeShort}" />
                        <GridViewColumn Header="크기" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                    </GridView>
                </ListView.View>
            </ListView>
            </Border>

            <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Detail panel -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24,20,24,24">

                        <!-- Nothing selected: how to use -->
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="사용 방법" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,10,0,6"
                                       Text="회사 PC를 포맷할 수 없을 때, 업무 프로그램과 업무 파일은 그대로 두고 개인정보만 지우는 도구입니다." />
                            <TextBlock Style="{StaticResource Body}" Text="1. 왼쪽 목록에서 항목을 누르면 어떤 개인정보가 있는지, 정확히 무엇을 지우는지 여기에 나옵니다." />
                            <TextBlock Style="{StaticResource Body}" Text="2. 지울 항목만 체크합니다. 처음부터 체크가 꺼진 항목은 업무용과 섞여 있을 수 있으니 하나씩 확인하세요." />
                            <TextBlock Style="{StaticResource Body}" Text="3. 처음 한 번은 아래쪽 연습 모드를 켜고 실행해서, 무엇이 지워질지 먼저 확인하세요." />
                            <TextBlock Style="{StaticResource Body}" Text="4. 확인이 끝나면 연습 모드를 끄고 [선택 항목 삭제]를 누릅니다." />
                        </StackPanel>

                        <!-- Selected item -->
                        <StackPanel DataContext="{Binding Selected}"
                                    Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <!-- Same category color bar as the list's group header. -->
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,3,10,3"
                                        Background="{Binding GroupInfo.Accent}" />
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />

                            <Border Background="#FFF1F0" Padding="12,10" Margin="0,14,0,0" CornerRadius="8"
                                    Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="지금은 지울 수 없습니다" FontWeight="Bold" Foreground="DarkRed" />
                                    <TextBlock Text="{Binding BlockReason}" Style="{StaticResource Body}" Foreground="DarkRed" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF1F0" Padding="12,10" Margin="0,14,0,0" CornerRadius="8"
                                    Visibility="{Binding Forced, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="개인 공동인증서는 반드시 지우는 항목이라 체크를 풀 수 없습니다." Style="{StaticResource Body}"
                                           Foreground="DarkRed" FontWeight="Bold" />
                            </Border>

                            <TextBlock Text="찾은 내용" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="(따로 보여 줄 내용이 없습니다)" Foreground="{StaticResource Muted}"
                                       Visibility="{Binding HasContents, Converter={StaticResource InvBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Contents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Body}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="지우는 범위" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Scope.Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:DetailLine}">
                                        <TextBlock x:Name="T" Text="{Binding Text}" Style="{StaticResource Body}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Muted">
                                                <Setter TargetName="T" Property="Foreground" Value="{StaticResource Muted}" />
                                                <Setter TargetName="T" Property="Margin" Value="0,8,0,2" />
                                                <Setter TargetName="T" Property="FontSize" Value="12" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Path">
                                                <Setter TargetName="T" Property="Foreground" Value="{StaticResource Muted}" />
                                                <Setter TargetName="T" Property="Margin" Value="12,0,0,0" />
                                                <Setter TargetName="T" Property="FontSize" Value="12" />
                                                <Setter TargetName="T" Property="LineHeight" Value="17" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="주의" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding Note}" Style="{StaticResource Body}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Busy overlay over list and detail while scanning/cleaning. The window itself keeps responding. -->
            <Grid Grid.ColumnSpan="3" Background="#CCF5F5F7"
                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <Border Width="460" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
                        Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="{Binding BusyTitle}" FontSize="17" FontWeight="Bold" />
                        <ProgressBar Height="6" Margin="0,14,0,10" Minimum="0" BorderThickness="0" Background="#E5E5EA"
                                     Maximum="{Binding ProgressMax, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" MinHeight="20" />
                        <Button Content="중지" Style="{StaticResource ToolButton}" Command="{Binding CancelCommand}"
                                HorizontalAlignment="Right" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Delete bar ===== -->
        <Border Grid.Row="4" Padding="24,14,24,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="{Binding CleanButtonText}" Command="{Binding CleanCommand}" />
                <CheckBox DockPanel.Dock="Left" Content="연습 모드 (실제로 지우지 않고 기록만 남김)" IsChecked="{Binding IsDryRun}"
                          VerticalAlignment="Center" Margin="18,0,18,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectionSummary}" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="18,0,0,0" />
            </DockPanel>
        </Border>

        <!-- ===== Log (collapsed by default) + version and [문제 알리기] on the right ===== -->
        <Grid Grid.Row="5" Margin="24,0,24,12">
            <Expander Header="진행 기록" IsExpanded="False" Foreground="{StaticResource Muted}">
                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="120" Margin="0,4,0,0"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontSize="12"
                         BorderBrush="{StaticResource Line}" TextChanged="LogBox_TextChanged" />
            </Expander>
            <!-- Declared after the Expander so it sits on top of the header line at the right edge and gets the clicks.
                 VerticalAlignment Top keeps it on the header row when the log is expanded. -->
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{StaticResource Muted}">
                <Run Text="{Binding VersionText, Mode=OneWay}" />
                <Run Text="  ·  " />
                <Hyperlink Command="{Binding ReportIssueCommand}" Foreground="{StaticResource Accent}" TextDecorations="None"
                           ToolTip="브라우저에서 문제 알리기 양식을 엽니다. 앱 버전과 Windows 버전만 미리 채워집니다.">문제 알리기</Hyperlink>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
